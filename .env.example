DB_NAME=tulsa_data
DB_USER=your_postgres_user
DB_PASSWORD=your_postgres_password
DB_HOST=localhost
DB_PORT=5432
DB_SSLMODE=prefer
MCP_HOST=127.0.0.1
MCP_PORT=8000
RATE_LIMIT_PER_MINUTE=60
STRIPE_SECRET_KEY=sk_test_your_test_key_here
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret_here
RESEND_API_KEY=re_your_resend_api_key_here
RESEND_FROM_EMAIL=keys@countylayer.com
# Signs the "manage your subscription" links emailed to customers - generate with
# `python3 -c "import secrets; print(secrets.token_hex(32))"`. If unset, those
# links are simply omitted from emails (no crash).
PORTAL_LINK_SECRET=
# From `stripe.billing_portal.Configuration.create(...)` - see billing.py's
# create_portal_session. Optional; if unset, Session.create falls back to the
# Stripe account's default portal configuration (if any).
STRIPE_PORTAL_CONFIGURATION_ID=
APP_BASE_URL=https://countylayer.com
